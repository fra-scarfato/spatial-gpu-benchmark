# The binary. A build product of `make`, ~230 KB, and regenerated on every
# build: committing it turns each rebuild into a diff of unreadable bytes and
# says nothing about whether the source changed.
runner

# Object files and other build leftovers.
*.o
*.d

# Profiling output. ncu and nsys reports are megabytes of binary that are
# regenerated rather than kept, and their names are not stable.
*.ncu-rep
*.nsys-rep
*.sqlite*

# Python bytecode from aggregate.py.
__pycache__/
*.pyc

# CSVs from a run invoked with the default prefix. The results tree is
# $DATA/bench ($DATA = /mnt/nvme/f.scarfato), outside this repository, so anything here is scratch.
bench_*

# Logs from a redirected sweep. The real results tree is $DATA/bench, outside this
# repository, so anything logged here is scratch.
*.log

# The two probe binaries. Build products of utility/Makefile, like `runner` is of
# this one: committed they would only be a diff of unreadable bytes.
utility/auxprobe
utility/wqprobe

# Editor and shell leftovers.
*~
*.swp
.vscode/

# Built artefacts: rebuild with make (runner) or make -C utility (tools).
utility/auxprobe
utility/wqprobe
utility/devprobe
utility/itfproc
